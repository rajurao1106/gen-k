# Runtime and HTTP server
PORT=5000

# Database (transactions require MongoDB Atlas or a local replica set)
MONGODB_URI=

# Authentication and OTP
# Required in production. Local demo mode (SMS_PROVIDER=dev) has local-only
# fallback secrets so this OTP demo works without adding credentials.

# Legacy alias. OTP_SECRET takes precedence if both are set.
OTP_HMAC_SECRET=
# Local/demo OTP is always 000000 when SMS_PROVIDER=dev outside production.
# This controls whether the development provider also prints it in the terminal.
DEV_SHOW_OTP=true
# dev is local-only; msg91 and twilio are placeholders, not live integrations.
SMS_PROVIDER=dev
# Comma-separated E.164 phone numbers promoted to admin after OTP verification.
ADMIN_PHONES=

# Browser/API networking
CORS_ORIGINS=http://localhost:3000
# Set only when the app is behind a trusted reverse proxy; numeric hop count.
TRUST_PROXY=
# Required only when the API is deployed on a different origin from the browser.
NEXT_PUBLIC_API_URL=
# Public canonical origin used for SEO metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development payment simulation (never a real gateway)
PAYMENT_MODE=demo
DEMO_PAYMENT_SECRET=replace-with-a-random-demo-secret-at-least-32-characters
PAYMENT_RATE_LIMIT_PER_MIN=20

# Gemini (server-only; never use NEXT_PUBLIC_ or client-exposed key names)
# Provide one or more comma-separated keys, or GEMINI_API_KEY, GEMINI_API_KEY_2, etc.
GEMINI_API_KEYS=
# Legacy VITE_API_KEY* aliases are still recognized server-side; migrate them
# to GEMINI_* and never define API keys in client-visible environment variables.
# Default model is gemini-3.5-flash-lite.
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite
GEMINI_RATE_LIMIT_PER_MIN=20
GEMINI_USER_RATE_LIMIT_PER_MIN=12
# Set to 0 to suppress provider-key rotation diagnostics in server logs.
GEMINI_LOG_KEY_USE=1
# Leave unset; enables the authenticated key-pool status route in production.
GEMINI_STATUS_ENABLED=

# Guide/profile write limits
GUIDE_RATE_LIMIT_PER_MIN=10
PROFILE_WRITE_RATE_LIMIT_PER_MIN=30

# Boson AI Higgs TTS (server-only; never use NEXT_PUBLIC_ for this key)
BOSON_API_KEY=
VOICE_PROVIDER_BASE_URL=https://api.boson.ai/v1
VOICE_PRESET=oliver
VOICE_RATE_LIMIT_PER_MIN=10
VOICE_DELETE_RATE_LIMIT_PER_MIN=10
VOICE_CHARACTERS_PER_DAY=10000
